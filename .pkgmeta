package-as: Move_FPS_Counter
enable-nolib-creation: no

manual-changelog: CHANGELOG.md

ignore:
    - LICENSE
    - README.md
    - .gitignore
    - .gitattributes
    - .github
    - tests
    # backup: these are gitignored and untracked, never packaged either way
    - AGENTS.md
    - AGENTS_MEMORY.md
